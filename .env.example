# Port the HTTP server listens on
PORT=3000
# Path of the MCP endpoint. For a public server, make it unguessable, e.g. /mcp/9f3c1d7a2b...
MCP_PATH=/mcp
# Public site shown in tool results
QRKITE_SITE_URL=https://qrkite.online
# Public https address of THIS server (no trailing slash). Enables image links in tool results
# and fills in openapi.yaml for ChatGPT Custom GPT Actions.
PUBLIC_URL=https://mcp.qrkite.online
# Max requests per IP per minute on /qr.* and /api/qr
RATE_LIMIT_PER_MIN=60
# Optional OAuth (needed for the Gemini app custom connector). Needs PUBLIC_URL too.
# Generate the secret with: openssl rand -hex 32
ENABLE_OAUTH=false
OAUTH_SECRET=
